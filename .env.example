# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://uptime:uptime@localhost:5432/backend_uptime?schema=public

# ── Redis (sessions cache, rate limiting, BullMQ) ────────────────────
REDIS_URL=redis://localhost:6379

# ── Better Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-secret
# Public URL of the API service (Better Auth handlers live under /api/auth)
BETTER_AUTH_URL=http://localhost:4000
# Public URL of the web app (trusted origin + email link target)
WEB_URL=http://localhost:3000

# ── API service ──────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of additional CORS origins (WEB_URL is always trusted)
CORS_ORIGINS=
# Optional bearer token protecting GET /metrics in production
METRICS_TOKEN=

# ── OAuth providers (leave empty to disable a provider) ──────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email delivery ───────────────────────────────────────────────────
# "ses" (Amazon SES) in production, "smtp" for local dev (Mailpit at
# localhost:1025), or "resend".
EMAIL_PROVIDER=smtp
EMAIL_FROM="Backend Uptime <no-reply@backenduptime.dev>"
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025

# Amazon SES (EMAIL_PROVIDER=ses). Domain uptimeflow.in must be verified in SES.
# Credentials are OPTIONAL: leave blank in AWS to use the IAM role / instance
# profile (recommended). Set static keys only for local dev or CI.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For SES: EMAIL_FROM=alerts@uptimeflow.in
EMAIL_MAX_RETRIES=3

# ── Billing ──────────────────────────────────────────────────────────
# BILLING_PROVIDER selects which processor is active ("stripe" | "razorpay").
# Both implement the same BillingProvider interface (packages/billing), so
# switching this one var is the only code-free step needed if Stripe becomes
# available later (Stripe requires manual/invite-based onboarding for India-
# based merchants at time of writing). Defaults to "razorpay".
BILLING_PROVIDER=razorpay

# ── Billing: Stripe ──────────────────────────────────────────────────
# All optional: leave blank to run without Stripe configured. When
# STRIPE_SECRET_KEY is set, STRIPE_WEBHOOK_SECRET must be set too. Use test-mode
# keys (sk_test_…/pk_test_…) outside production. NEVER commit real keys.
# Only read when BILLING_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# `stripe listen` prints this (whsec_…); in prod it's the dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=
# Optional: map each plan tier to its Stripe Price/Product id so the seeded plan
# catalog matches the Stripe dashboard. Read by the db seed when present.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# ── Billing: Razorpay ────────────────────────────────────────────────
# All optional: leave blank to run without Razorpay configured. When
# RAZORPAY_KEY_ID is set, RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must
# be set too. Use test-mode keys (rzp_test_…) outside production. Only read
# when BILLING_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set from the Razorpay Dashboard → Webhooks when creating the endpoint.
RAZORPAY_WEBHOOK_SECRET=
# Optional: map each plan tier to its Razorpay Plan id so the seeded plan
# catalog matches the Razorpay dashboard. Read by the db seed when present.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_BUSINESS=

# ── Web app (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Stripe publishable key exposed to the browser (pk_test_… / pk_live_…). Only
# used when BILLING_PROVIDER=stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Razorpay key id exposed to the browser (rzp_test_… / rzp_live_…) — boots
# Checkout.js on /dashboard/billing/checkout. Only used when
# BILLING_PROVIDER=razorpay. Safe to expose (it's the public half of the
# keypair, same as a Stripe publishable key).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Comma-separated hostnames the app serves on; any OTHER host is treated as a
# customer custom domain and rewritten to its status page (localhost always
# included). e.g. uptimeflow.app,www.uptimeflow.app
NEXT_PUBLIC_APP_HOSTNAMES=

# ── Observability ────────────────────────────────────────────────────
# When set, OpenTelemetry traces are exported via OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
